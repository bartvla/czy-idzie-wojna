{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "czyidziewojna-live",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    // Originy, które mogą korzystać z proxy (produkcja, GitHub Pages przed podpięciem domeny, dev lokalny).
    "ALLOWED_ORIGINS": "https://czyidziewojna.pl,https://www.czyidziewojna.pl,https://bartvla.github.io,http://localhost:5173",
    "CONTACT_URL": "https://czyidziewojna.pl/kontakt"
  }
}
