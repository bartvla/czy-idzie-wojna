{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "czyidziewojna-live",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "vars": {
    // Originy, które mogą korzystać z proxy. Lokalny wrangler dev przyjmuje każdy origin automatycznie (patrz index.ts).
    "ALLOWED_ORIGINS": "https://czyidziewojna.pl,https://www.czyidziewojna.pl,https://bartvla.github.io",
    // Repozytorium, z którego gałęzi data Worker czyta aircraft.json / snapshot.json
    "DATA_REPO": "bartvla/czy-idzie-wojna"
  }
}
